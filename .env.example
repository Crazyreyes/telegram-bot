# Copy this file to .env for local development. Never commit .env.
# On a host, set these same variables in the host's panel instead of using a .env file.

# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram chat that receives stream notifications
STREAM_LOG_CHAT_ID=

# Telegram chat for the bot's own messages (e.g. startup notices)
DUMP_CHAT_ID=

# Twitch API credentials from https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Comma-separated Twitch usernames to monitor (no spaces needed).
# These are kept here so the monitored channels are never in the code.
TWITCH_STREAMERS=streamer_one,streamer_two

# PostgreSQL connection. Either set DATABASE_URL directly (preferred when
# the host provides one), or set the five PG* variables below instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# PGHOST=
# PGPORT=
# PGDATABASE=
# PGUSER=
# PGPASSWORD=
